# Axis portal login URL opened when the worker starts.
AXIS_PORTAL_URL=https://hdb-portal.vercel.app/axis/Login.html

# Delay in milliseconds between Playwright browser actions. Use 0 for no delay.
AXIS_SLOW_MO_MS=0

# CRM API used to fetch the pending case list.
CASE_LIST_API=

# CRM API used to fetch complete details for one token ID.
DETAILS_API=

# CRM client identifier sent with the pending-list request.
CRM_CLIENT_ID=

# Secret authentication key sent in the X-API-Key header for CRM requests.
CRM_API_KEY=

# CRM API used to set a process to running, completed, or failed.
UPDATE_STATUS_API=https://banradcrm.in/common.php

# Default final status retained for compatibility; the worker explicitly sends
# running/completed/failed according to the process result.
UPDATE_STATUS=completed

# false uploads documents/dummypdf.pdf; true requires <loanNumber>-RV/OV.pdf.
USE_DYNAMIC_PDF=false

# Delay in milliseconds before checking the CRM again when no work is available.
POLL_INTERVAL_MS=10000

# Maximum records attempted in one run. Use 0 or leave blank for unlimited mode.
PROCESS_LIMIT=0
