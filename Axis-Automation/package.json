{
  "name": "axis-bank-automation",
  "version": "1.0.0",
  "description": "Axis Bank Portal Automation using Playwright",
  "main": "scripts/runAxisVerificationWorker.js",
  "scripts": {
    "test": "playwright test",
    "start:axis": "node scripts/runAxisVerificationWorker.js",
    "test:axis": "playwright test tests/axis/axisFlow.spec.js --headed",
    "debug:axis": "playwright test tests/axis/axisFlow.spec.js --headed --debug",
    "worker:axis": "node scripts/runAxisVerificationWorker.js",
    "worker:ov": "node scripts/runAxisVerificationWorker.js OV",
    "worker:rv": "node scripts/runAxisVerificationWorker.js RV",
    "update-status": "playwright test tests/updateStatus.spec.js",
    "test:mappings": "node --test unit-tests/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
