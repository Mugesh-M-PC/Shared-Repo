# Unified HDB worker runtime --------
# Values are milliseconds.

# Check for completion of manual portal authentication every 5 seconds.
HDB_AUTH_CHECK_INTERVAL_MS=5000

# Show a one-time manual-login alert after 48 hours; waiting still continues.
HDB_AUTH_ALERT_MS=172800000

# Refresh an idle authenticated listing every 5 minutes.
HDB_KEEPALIVE_INTERVAL_MS=300000

# Poll CRM once per minute when no work is available.
HDB_POLL_INTERVAL_MS=60000

# Retry queued XLSX and CSV writes every 10 seconds while Excel holds a file lock.
HDB_REPORT_SYNC_INTERVAL_MS=10000

# Disable artificial Playwright delay in production.
HDB_SLOW_MO_MS=0

